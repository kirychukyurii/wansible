---
# Скопіюйте у vault.yml та зашифруйте: ansible-vault encrypt group_vars/all/vault.yml
# Доступ до хостів (однаковий логін/пароль на всіх VM):
vault_ansible_password: CHANGE_ME_ssh_password
vault_ansible_become_password: CHANGE_ME_sudo_password   # пароль для sudo

# Обов'язкові:
vault_webitel_repo_s3_access_key: CHANGE_ME
vault_webitel_repo_s3_secret_key: CHANGE_ME
vault_freeswitch_signalwire_key: pat_CHANGE_ME
vault_webitel_cookie_seed: CHANGE_ME_to_a_random_secret

# HA-специфічні (обов'язкові для HA-розгортання):
# Згенерувати: consul keygen
vault_consul_encrypt_key: CHANGE_ME_consul_keygen_output

# Спільний Erlang cookie для кластера RabbitMQ (однаковий на всіх вузлах обох ДЦ)
vault_rabbitmq_erlang_cookie: CHANGE_ME_to_a_long_random_string

# Паролі Patroni (PostgreSQL HA, однакові в обох ДЦ)
vault_patroni_superuser_password: CHANGE_ME_superuser
vault_patroni_replication_password: CHANGE_ME_replication
vault_patroni_rewind_password: CHANGE_ME_rewind
vault_patroni_restapi_password: CHANGE_ME_restapi

# Grafana backend DB (Postgres, primary-ДЦ)
vault_grafana_db_password: CHANGE_ME_grafana_db
# Grafana admin web-логін (опційно; не задано → дефолт webitel)
vault_grafana_admin_password: CHANGE_ME_grafana_admin
