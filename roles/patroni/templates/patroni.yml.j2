# {{ ansible_managed }}
scope: {{ patroni_scope }}
name: {{ ansible_hostname }}

log:
  level: INFO
  type: plain

restapi:
  listen: {{ patroni_node_ip }}:8008
  connect_address: {{ patroni_node_ip }}:8008
{% if patroni_tls_enabled | bool %}
  cafile: {{ patroni_ssl_dir }}/ca.pem
  certfile: {{ patroni_ssl_dir }}/{{ inventory_hostname }}.pem
  keyfile: {{ patroni_ssl_dir }}/{{ inventory_hostname }}-key.pem
{% endif %}
  authentication:
    username: {{ patroni_restapi_user }}
    password: {{ patroni_restapi_password }}

consul:
  host: {{ patroni_consul_host }}
  register_service: true
  service_tags:
    - {{ patroni_scope }}

bootstrap:
  dcs:
    ttl: {{ patroni_ttl }}
    loop_wait: {{ patroni_loop_wait }}
    retry_timeout: {{ patroni_retry_timeout }}
    synchronous_mode: {{ patroni_synchronous_mode | bool | lower }}
    maximum_lag_on_failover: 1048576
{% if patroni_is_standby | bool %}
    standby_cluster:
      host: {{ patroni_standby_cluster_host }}
      port: {{ patroni_standby_cluster_port }}
      create_replica_methods:
        - basebackup
{% endif %}
    postgresql:
      use_pg_rewind: true
      parameters:
        max_connections: 200
        shared_preload_libraries: timescaledb
  initdb:
    - encoding: UTF8
    - data-checksums

postgresql:
  listen: 127.0.0.1,{{ patroni_node_ip }}:5432
  connect_address: {{ patroni_node_ip }}:5432
  bin_dir: /usr/lib/postgresql/{{ patroni_major }}/bin
  data_dir: /var/lib/postgresql/{{ patroni_major }}/main
  use_pg_rewind: true
  pg_hba:
    - local all all peer
    - host all all 127.0.0.1/32 scram-sha-256
{% for h in patroni_cluster_hosts %}
    - host all all {{ hostvars[h].ansible_default_ipv4.address | default(hostvars[h].ansible_host) }}/32 scram-sha-256
{% endfor %}
{% for h in groups['patroni'] | default([]) %}
    - host replication {{ patroni_replication_user }} {{ hostvars[h].ansible_default_ipv4.address | default(hostvars[h].ansible_host) }}/32 scram-sha-256
{% endfor %}
{% for h in groups['all'] | difference(patroni_cluster_hosts) %}
    - host all {{ patroni_app_user }} {{ hostvars[h].ansible_default_ipv4.address | default(hostvars[h].ansible_host) }}/32 scram-sha-256
{% endfor %}
{% for h in (groups['grafana'] | default([])) | difference(patroni_cluster_hosts) %}
    - host {{ grafana_db_name }} {{ grafana_db_user }} {{ hostvars[h].ansible_default_ipv4.address | default(hostvars[h].ansible_host) }}/32 scram-sha-256
    - host {{ webitel_pg_db }} {{ grafana_datasource_user }} {{ hostvars[h].ansible_default_ipv4.address | default(hostvars[h].ansible_host) }}/32 scram-sha-256
{% endfor %}
  authentication:
    superuser:
      username: {{ patroni_superuser_user }}
      password: {{ patroni_superuser_password }}
    replication:
      username: {{ patroni_replication_user }}
      password: {{ patroni_replication_password }}
    rewind:
      username: {{ patroni_rewind_user }}
      password: {{ patroni_rewind_password }}

tags:
  failover_priority: {{ patroni_failover_priority }}
  clonefrom: true
  noloadbalance: false
  nostream: false
  nosync: false
